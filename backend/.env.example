# Local development. Copy to .env and fill in.
# Production values live only in Render's environment settings, never in a local file.

# Dev database: Atlas user with readWrite on gullyeats_dev only, so a mistake can't reach prod.
MONGO_URI=mongodb+srv://gullyeats_dev:<password>@cluster0.s601e.mongodb.net/gullyeats_dev?retryWrites=true&w=majority
# Different from production, so dev tokens never work there.
JWT_SECRET=
PORT=5000
NODE_ENV=development

AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
BUCKET_NAME=

# Test-mode keys only (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MERCHANT_NAME=GullyEats

# Comma-separated origins allowed by CORS; the first customer origin is what new QR posters open.
FRONTEND_URL_CUSTOMER=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_ADMIN=http://localhost:5174

# Optional; features skip themselves when unset.
PIXABAY_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
# Open-Meteo commercial key (GullyWeather). Without it the free, non-commercial API is used.
OPEN_METEO_API_KEY=
